    ON f.location_key = l.location_key
   AND f.date_key = d.date_key
LEFT JOIN warehouse.meta_record_lineage rl
    ON rl.target_table = 'warehouse.fact_sales'
   AND rl.target_record_id = f.sales_fact_key::TEXT
GROUP BY
