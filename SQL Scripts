CREATE TABLE IF NOT EXISTS warehouse.model_run (
    model_run_id BIGSERIAL PRIMARY KEY,
    run_key VARCHAR(100) NOT NULL UNIQUE,
    model_name VARCHAR(100) NOT NULL,
    model_version VARCHAR(50),
    task_type VARCHAR(30) NOT NULL,
    source_view VARCHAR(150),
    training_start DATE,
    training_end DATE,
    evaluation_start DATE,
    evaluation_end DATE,
    parameters JSONB,
    metrics JSONB,
    run_status VARCHAR(30) NOT NULL DEFAULT 'COMPLETED',
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS warehouse.forecast_result (
    forecast_result_id BIGSERIAL PRIMARY KEY,
    model_run_id BIGINT NOT NULL
        REFERENCES warehouse.model_run(model_run_id),
    forecast_month DATE NOT NULL,
    forecast_value NUMERIC(18,2) NOT NULL,
    lower_bound NUMERIC(18,2),
    upper_bound NUMERIC(18,2),
    actual_value NUMERIC(18,2),
    forecast_type VARCHAR(30) NOT NULL DEFAULT 'FUTURE',
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UNIQUE (model_run_id, forecast_month)
);

CREATE TABLE IF NOT EXISTS warehouse.anomaly_result (
    anomaly_result_id BIGSERIAL PRIMARY KEY,
    model_run_id BIGINT NOT NULL
        REFERENCES warehouse.model_run(model_run_id),
    month_start DATE NOT NULL,
    region VARCHAR(100) NOT NULL,
    observed_sales NUMERIC(18,2) NOT NULL,
    detector_method VARCHAR(50) NOT NULL,
    anomaly_label VARCHAR(30) NOT NULL,
    anomaly_score NUMERIC(18,6),
    lower_threshold NUMERIC(18,2),
    upper_threshold NUMERIC(18,2),
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UNIQUE (model_run_id, month_start, region)
);

CREATE INDEX IF NOT EXISTS idx_forecast_result_month
    ON warehouse.forecast_result(forecast_month);

CREATE INDEX IF NOT EXISTS idx_anomaly_result_month_region
    ON warehouse.anomaly_result(month_start, region);

