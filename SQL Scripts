UPDATE warehouse.meta_source_object
    SET business_definition = CASE object_name
        WHEN 'sales_customers' THEN 'Customer master records for the Sales department.'
        WHEN 'sales_products' THEN 'Product details maintained by the Sales department.'
        WHEN 'sales_locations' THEN 'Geographical locations used for sales transactions.'
        WHEN 'sales_transactions' THEN 'Sales transaction header records.'
        WHEN 'sales_transaction_lines' THEN 'Individual product lines belonging to sales transactions.'
        WHEN 'purchasing_suppliers' THEN 'Supplier master records for purchasing activities.'
        WHEN 'purchasing_products' THEN 'Products maintained by the Purchasing department.'
        WHEN 'purchasing_orders' THEN 'Purchase order header records.'
        WHEN 'purchasing_order_lines' THEN 'Individual product lines belonging to purchase orders.'
        WHEN 'purchasing_locations' THEN 'Locations maintained by the Purchasing department.'
        WHEN 'inventory_products' THEN 'Product master records used for inventory management.'
        WHEN 'inventory_locations' THEN 'Locations where inventory is managed.'
        WHEN 'inventory_transactions' THEN 'Inventory movement transaction header records.'
        WHEN 'inventory_transaction_lines' THEN 'Individual lines describing inventory movements.'
        WHEN 'inventory_stock_levels' THEN 'Recorded stock quantities by product and location.'
        WHEN 'finance_accounts' THEN 'Financial accounts used to classify financial transactions.'
        WHEN 'finance_departments' THEN 'Department records used for financial reporting.'
        WHEN 'finance_transactions' THEN 'Financial transaction header records.'
        WHEN 'finance_transaction_lines' THEN 'Individual financial transaction entries.'
        WHEN 'finance_budgets' THEN 'Monthly departmental financial budget records.'
        ELSE business_definition
    END;

    UPDATE warehouse.meta_source_column
    SET
        business_term = CASE
            WHEN column_name LIKE '%_id' THEN 'Identifier'
            WHEN column_name IN ('quantity', 'units') THEN 'Quantity'
            WHEN column_name LIKE '%price%' THEN 'Unit Price'
            WHEN column_name LIKE '%cost%' THEN 'Unit Cost'
            WHEN column_name LIKE '%amount%' OR column_name LIKE '%total%' THEN 'Monetary Amount'
            WHEN column_name LIKE '%date%' OR column_name LIKE '%time%' THEN 'Date or Time'
            WHEN column_name LIKE '%name%' THEN 'Name'
            WHEN column_name LIKE '%city%' THEN 'City'
            WHEN column_name LIKE '%region%' THEN 'Region'
            WHEN column_name LIKE '%country%' THEN 'Country'
            WHEN column_name LIKE '%category%' THEN 'Category'
            WHEN column_name LIKE '%type%' THEN 'Type'
            WHEN column_name LIKE '%status%' THEN 'Status'
            WHEN column_name LIKE '%currency%' THEN 'Currency'
            ELSE 'Source Attribute'
        END,
        business_definition = CASE
            WHEN column_name LIKE '%_id' THEN 'Identifier used to identify a source record or related entity.'
            WHEN column_name IN ('quantity', 'units') THEN 'Number of units associated with the transaction or record.'
            WHEN column_name LIKE '%price%' THEN 'Price per unit of the product.'
            WHEN column_name LIKE '%cost%' THEN 'Cost associated with a product or transaction.'
            WHEN column_name LIKE '%amount%' OR column_name LIKE '%total%' THEN 'Monetary value associated with the financial or operational record.'
            WHEN column_name LIKE '%date%' OR column_name LIKE '%time%' THEN 'Date or timestamp associated with the record.'
            WHEN column_name LIKE '%name%' THEN 'Descriptive name of the associated entity.'
            WHEN column_name LIKE '%city%' THEN 'City associated with the location.'
            WHEN column_name LIKE '%region%' THEN 'Geographical region associated with the location.'
            WHEN column_name LIKE '%country%' THEN 'Country associated with the location.'
            WHEN column_name LIKE '%category%' THEN 'Classification category associated with the record.'
            WHEN column_name LIKE '%type%' THEN 'Type or classification of the record.'
            WHEN column_name LIKE '%status%' THEN 'Current status of the record.'
            WHEN column_name LIKE '%currency%' THEN 'Currency used for the monetary value.'
            ELSE 'Attribute captured from the original departmental source system.'
        END;

