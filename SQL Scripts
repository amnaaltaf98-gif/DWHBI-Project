CREATE OR REPLACE VIEW warehouse.vw_region_monthly_sales_anomaly_features AS
SELECT
    d.year_number,
    d.month_number,
    DATE_TRUNC('month', d.full_date)::DATE AS month_start,
    l.region,
    SUM(f.sales_amount) AS monthly_sales,
