         FROM warehouse.model_run) AS model_runs,

        (SELECT COUNT(*)
         FROM warehouse.forecast_result) AS forecast_records,

        (SELECT COUNT(*)
         FROM warehouse.anomaly_result) AS anomaly_records,

        (SELECT COUNT(*)
         FROM (
             SELECT run_key
             FROM warehouse.model_run
             GROUP BY run_key
             HAVING COUNT(*) > 1
         ) duplicates) AS duplicate_model_runs,

        (SELECT COUNT(*)
         FROM (
             SELECT model_run_id, forecast_month
             FROM warehouse.forecast_result
             GROUP BY model_run_id, forecast_month
             HAVING COUNT(*) > 1
         ) duplicates) AS duplicate_forecasts,

        (SELECT COUNT(*)
         FROM (
             SELECT model_run_id, month_start, region
             FROM warehouse.anomaly_result
             GROUP BY model_run_id, month_start, region
             HAVING COUNT(*) > 1
         ) duplicates) AS duplicate_anomalies;

